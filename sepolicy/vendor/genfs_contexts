# Display param
genfscon sysfs /devices/virtual/mi_display/disp_feature/disp-DSI-0/disp_param                                u:object_r:sysfs_disp_param:s0

# Kprofiles
genfscon sysfs /module/kprofiles/parameters/auto_kp                                                          u:object_r:sysfs_kprofiles:s0
genfscon sysfs /kernel/kprofiles/kp_mode                                                                     u:object_r:sysfs_kprofiles:s0

# Panel Orientation
genfscon sysfs /devices/virtual/touch/touch_dev/panel_orientation                                            u:object_r:vendor_sysfs_sensors:s0

# Thermal Profiles
genfscon sysfs /devices/virtual/thermal/thermal_message/sconfig                                              u:object_r:sysfs_thermal_sconfig:s0

# Edge Rejection
genfscon sysfs /devices/virtual/touch/touch_dev/grip_rejection                                               u:object_r:vendor_sysfs_sensors:s0

# Sound Control
genfscon sysfs /kernel/sound_control/headphone_gain                                                          u:object_r:sysfs_hgain:s0
genfscon sysfs /kernel/sound_control/mic_gain                                                                u:object_r:sysfs_mgain:s0
genfscon sysfs /kernel/sound_control/speaker_gain                                                            u:object_r:sysfs_sgain:s0

genfscon sysfs /devices/virtual/touch/touch_dev/bump_sample_rate u:object_r:vendor_sysfs_touch:s0
