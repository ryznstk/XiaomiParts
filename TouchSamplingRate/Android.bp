android_app {
    name: "Touchservice",

    defaults: [
        "SettingsLibDefaults",
    ],

    srcs: [
        "src/**/*.kt",
        "src/**/*.java",
    ],

    resource_dirs: ["res"],

    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,

    static_libs: [
        "androidx.core_core",
        "androidx.activity_activity-compose",
        "androidx.compose.animation_animation",
        "androidx.compose.foundation_foundation",
        "androidx.compose.material3_material3",
        "androidx.compose.material_material-icons-extended",
        "androidx.compose.runtime_runtime",
        "androidx.compose.ui_ui",
        "androidx.compose.ui_ui-text",
        "androidx.compose.ui_ui-tooling-preview",
        "androidx.lifecycle_lifecycle-runtime-compose",
        "androidx.preference_preference",
        "org.lineageos.settings.resources",
    ],

    init_rc: [
        "init/init.touchservice.rc",
    ],

    required: [
        "privapp_whitelist_com.android.touchservices.xml",
    ],
}

prebuilt_etc {
    name: "privapp_whitelist_com.android.touchservices.xml",

    src: "permissions/privapp_whitelist_com.android.touchservices.xml",

    sub_dir: "permissions",
    system_ext_specific: true,
}
